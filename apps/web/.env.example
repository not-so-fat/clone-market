# Relative SQLite paths resolve against the Clone Market repository root
# (not the Next.js cwd). Prefer absolute paths so smoke:v0:live and `next dev`
# always share one file.
CLONE_MARKET_CATALOG_DB=./data/catalog.sqlite
CLONE_MARKET_EVIDENCE_DB=./data/evidence.sqlite
CLONE_MARKET_ARTIFACT_DIR=./data/artifacts
CLONE_MARKET_GROK_BASE_URL=https://x.ai/bot/marketplace/
# Optional. Leave unset for V0 preview/export/offline verify (declared Botmancers
# capabilities; no HTTP). Set only if you intend to call a local Botmancers import
# API (not required for V0). Do not set https://api.botmancers.com/.
# CLONE_MARKET_BOTMANCERS_BASE_URL=http://127.0.0.1:43123/
# CLONE_MARKET_BOTMANCERS_UI_BASE_URL=http://127.0.0.1:43123/
# Live smoke template override (provider:externalId). Fixture default is grok-marketplace:bot-projects-manager-20261002.
# CLONE_MARKET_ACCEPTANCE_TEMPLATE=grok-marketplace:bot-projects-manager-20261002
# Peer Botmancers checkout verification is outside V0 acceptance (never required by default npm test):
# CLONE_MARKET_ACCEPTANCE_PEER_REPOS=1
# BOTMANCERS_ROOT=/absolute/path/to/botmancers
