{
  "name": "@clone-market/target-botmancers",
  "version": "0.1.0",
  "description": "Reviewed Botmancers target adapter for Clone Market",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": { "node": ">=20" },
  "cloneMarket": { "layer": "target" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/target-botmancers/src"
  },
  "dependencies": {
    "@clone-market/compatibility": "0.1.0",
    "@clone-market/core": "0.1.0"
  }
}
