{
  "name": "clone-market",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ],
  "cloneMarket": {
    "coreDependencies": ["zod"]
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "build:web": "npm run build --workspace=@clone-market/web",
    "test": "npm run build && vitest run",
    "lint": "node scripts/check-boundaries.mjs && node scripts/check-web-boundaries.mjs && tsc -p tsconfig.lint.json --pretty false",
    "test:web": "vitest run apps/web"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "typescript": "5.9.2",
    "vitest": "1.6.1"
  }
}
